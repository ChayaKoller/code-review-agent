GOOGLE_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=code-review-agent
MODEL_NAME=gemini-3.1-flash-lite
# אופציונלי: מודל נפרד למאמת (ריק = אותו מודל)
CHECK_MODEL_NAME=
# אופציונלי: חשיבה בשלב החיפוש (low/medium/high, ריק = ברירת המחדל של המודל, מומלץ), וקריאות במקביל (1 = בלי מקביליות)
FIND_THINKING_LEVEL=
MAX_PARALLEL_CALLS=4
# אופציונלי (v13): מספר סבבים מקסימלי בריצה (1 = סבב אחד)
MAX_ROUNDS=3
